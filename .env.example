# Nkanyezi LMS — local development defaults
# Copy to .env and adjust before running `npm run dev`.

DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"

# Signs session cookies and encrypts saved AI provider keys (fallback).
AUTH_SECRET="change-me-to-a-long-random-string"

# Dedicated encryption key for API keys saved in Settings → AI models.
# Generate one with: openssl rand -base64 32
AI_SECRET="change-me-to-a-long-random-string"

# Optional hosted AI providers. Any one is enough; the local model
# always works without a key. You can also save keys in the UI.
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GOOGLE_API_KEY=""
# GROQ_API_KEY=""
# OPENROUTER_API_KEY=""
# MISTRAL_API_KEY=""
# TOGETHER_API_KEY=""
# DEEPSEEK_API_KEY=""
# XAI_API_KEY=""

# Optional model overrides.
# OPENAI_MODEL="gpt-4.1-mini"
# ANTHROPIC_MODEL="claude-sonnet-4-5"
# GEMINI_MODEL="gemini-2.5-flash"

# Local Ollama (no API key required).
# OLLAMA_BASE_URL="http://localhost:11434/v1"
# OLLAMA_MODEL="llama3.1"

# Any OpenAI-compatible endpoint.
# AI_BASE_URL=""
# AI_MODEL=""
# AI_API_KEY=""

# SMTP email delivery. When configured, notifications/messages/invites are sent by email.
# Without SMTP, emails are stored in the in-app outbox for local development.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="you@example.com"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="Nkanyezi LMS <no-reply@example.com>"

# Login anti-bot. OTP email verification is always enabled on credential login.
# Set to "true" to also require a generated text challenge on the login form.
# LOGIN_TEXT_CHALLENGE="false"
